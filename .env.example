# PostgreSQL. install.sh fills this in for a local self-hosted install; on
# Render, DATABASE_URL is injected automatically from the managed database
# instead (see render.yaml) — a bare "postgres://"/"postgresql://" URL is
# accepted either way, the app rewrites it to the psycopg3 dialect itself.
DATABASE_URL=postgresql+psycopg://odds:odds@localhost:5432/odds

# Odds provider (e.g. The Odds API)
ODDS_API_KEY=
ODDS_API_BASE_URL=https://api.the-odds-api.com/v4
ODDS_API_REGIONS=eu
ODDS_API_TIMEOUT_SECONDS=10
# How many days back the /scores endpoint (results feed) looks (1-3)
ODDS_API_SCORES_DAYS_FROM=3

# Provider sport_keys polled periodically for fresh odds (app/scheduler.py).
# Comma-separated; adjust to the competitions you actually want to track.
# Only season-long team-sport keys are listed by default: individual/
# tournament sports (tennis, golf, ...) are scoped per-tournament by The
# Odds API (e.g. "tennis_atp_us_open") with no single stable season key, so
# check https://api.the-odds-api.com/v4/sports?apiKey=YOUR_KEY for the
# current valid keys before adding one of those.
TRACKED_SPORT_KEYS=soccer_epl,soccer_france_ligue_one,soccer_uefa_champs_league,basketball_nba
ODDS_INGESTION_INTERVAL_MINUTES=5

# Bookmaker keys (as returned by the provider) flagged as ANJ-licensed French
# books, and the sharp reference used for devig/edge. Comma-separated; adjust
# to match the exact keys exposed by the active provider/region.
ANJ_BOOKMAKER_KEYS=winamax_fr,betclic,unibet_fr,zebet_fr,pmu_fr
SHARP_REFERENCE_BOOKMAKER_KEY=pinnacle

# Freshness
STALE_ODDS_MINUTES=10

# Calculation defaults (also editable in the Settings page)
DEVIG_METHOD=multiplicative
KELLY_FRACTION=0.25
KELLY_CAP_PCT=0.02
EDGE_THRESHOLD=0.03

DEFAULT_BANKROLL=1000
MONTHLY_LOSS_LIMIT=

# Shared-secret key required (via the X-API-Key header) on every API request
# once the app is exposed beyond localhost. install.sh generates one
# automatically for a local self-hosted install (baked into the frontend
# build as VITE_API_KEY too, since the backend serves it same-origin).
# Leave empty only for a pure localhost / dev setup.
API_KEY=

LOG_LEVEL=INFO

# Standalone scheduler (app/scheduler.py) -- job intervals
CLOSING_CAPTURE_INTERVAL_MINUTES=5
AUTO_SETTLEMENT_INTERVAL_MINUTES=15

# Only relevant if the frontend is served from a different origin than the
# API (e.g. the Vite dev server on :5173, or a split Vercel deployment) —
# a local self-hosted install (install.sh) serves both same-origin and
# never hits CORS at all.
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
